# Postgres (yerel: docker compose up -d, sonra migrate)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noqta"

# Oturum imzası — en az 32 karakter
AUTH_SECRET="change-me-use-openssl-rand-hex-32"

# Site URL (İyzico callback için; production’da kesin set edin)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# İyzico (sandbox)
IYZIPAY_URI="https://sandbox-api.iyzipay.com"
IYZIPAY_API_KEY=""
IYZIPAY_SECRET_KEY=""

# Sandbox alıcı test alanları (gerçek müşteri verisi için profilden toplanmalı)
IYZIPAY_BUYER_IDENTITY="74300864791"
IYZIPAY_BUYER_GSM="+905350000000"

# Rate limit (üretimde Vercel çok instance olduğu için Upstash önerilir; yoksa bellek içi zayıf limit)
# https://upstash.com — Redis REST URL + token
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Vercel dışı HTTPS prod’da HSTS için: ENABLE_HSTS="true"

# Google OAuth (Cloud Console → OAuth 2.0 Client → Authorized redirect URI: {SITE}/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
